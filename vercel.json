{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/buscar-equipo?vista=sitemap"
    },
    {
      "source": "/clasificacion",
      "destination": "/api/buscar-equipo?vista=liga"
    },
    {
      "source": "/clasificacion/:l",
      "destination": "/api/buscar-equipo?vista=liga&l=:l"
    },
    {
      "source": "/demo/",
      "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/index.html"
    },
    {
      "source": "/demo",
      "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/index.html"
    },
    {
      "source": "/marianistas/",
      "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/index.html"
    },
    {
      "source": "/marianistas",
      "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/index.html"
    },
    {
      "source": "/marianistas/:path+",
      "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/:path+"
    },
    {
      "source": "/:club([a-z0-9-]{2,40})/manifest.webmanifest",
      "destination": "/api/manifest?club=:club"
    },
    {
      "source": "/:club([a-z0-9-]{2,40})/",
      "destination": "/api/pagina?club=:club"
    },
    {
      "source": "/:club([a-z0-9-]{2,40})",
      "destination": "/api/pagina?club=:club"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/correos-prueba",
      "schedule": "0 8 * * *"
    }
  ]
}