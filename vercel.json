{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/marianistas", "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/" },
    { "source": "/marianistas/:path*", "destination": "https://juvenil-a-marianistas.vercel.app/marianistas/:path*" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
